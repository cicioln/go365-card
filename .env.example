# 复制为 .env 后按需修改（启动命令：node --env-file=.env ... 或 npm run start:env）

PORT=3000
# 对外访问地址，用于生成支付回调地址，必须是支付平台能访问到的公网地址
PUBLIC_URL=https://shop.example.com
# 首次启动时创建的管理员 admin 的密码；不填则随机生成并打印在控制台
ADMIN_PASSWORD=
# 部署在 HTTPS 下设为 1（Cookie 仅通过 HTTPS 发送）
COOKIE_SECURE=1
# 部署在 Nginx 等反向代理后设为 1，按 X-Forwarded-For 识别客户端 IP（用于限流）
TRUST_PROXY=1
# 未支付订单的保留分钟数，超时自动关闭并释放库存
ORDER_TTL_MINUTES=15
# 数据目录（SQLite 数据库、上传图片、签名密钥），务必定期备份
DATA_DIR=data

# 支付：mock 为本地模拟收银台（仅测试用）；epay 为易支付协议
PAY_PROVIDER=epay
EPAY_URL=https://pay.example.com
EPAY_PID=1000
EPAY_KEY=
