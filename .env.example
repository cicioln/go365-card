# 全部可选。不创建 .env 也能直接启动：管理员账号、支付网关、站点地址都在后台设置。
# 这里设置了的项会覆盖后台设置，后台对应输入框变为只读。

# ---- 服务器 ----
# Docker 部署时对外暴露的端口
HOST_PORT=3000
# 部署在 Nginx / Caddy 等反向代理后面时设为 1（按 X-Forwarded-* 识别真实 IP 与 https）
# 没有反向代理时不要开启，否则他人可伪造 IP 绕过登录限流
TRUST_PROXY=0
# 未支付订单的保留分钟数，超时自动关闭并释放库存
ORDER_TTL_MINUTES=15

# ---- 以下一般不需要设置 ----
# 跳过安装向导，直接创建管理员 admin 并使用此密码
# ADMIN_PASSWORD=
# 对外访问地址（默认使用后台「支付渠道」中的站点地址）
# PUBLIC_URL=https://shop.example.com
# Cookie 仅走 HTTPS：不设置时按访问协议自动判断；1 强制开启，0 强制关闭
# COOKIE_SECURE=
# 支付网关（默认在后台设置）
# PAY_PROVIDER=epay
# EPAY_URL=https://pay.example.com
# EPAY_PID=1000
# EPAY_KEY=
