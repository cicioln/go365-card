    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/vue-3": "3.31.4",
    "hono": "4.13.13",
    "lucide-vue-next": "0.525.0",
    "pinia": "3.0.3",
    "qrcode": "1.5.4",
    "sanitize-html": "2.18.0",
    "vue": "3.5.44",
    "vue-i18n": "11.1.11",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/tsconfig": "0.7.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
