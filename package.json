{
  "name": "go365-clone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --experimental-strip-types --watch server/index.ts",
    "build": "vue-tsc -b && tsc -p tsconfig.server.json && vite build",
